# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# Database Configuration (defaults to instance/library_tqm.db if unset)
DATABASE_URL=sqlite:///library_tqm.db

# Session & Security Settings
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_ENABLED=True

# Library Policy Defaults
DEFAULT_LOAN_DAYS=14
DEFAULT_FINE_PER_DAY=2.00
grace_period_days=0
